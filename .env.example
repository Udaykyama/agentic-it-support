# Local evaluation only. Authentication is still required in development.
# Copy to .env, protect it with chmod 600, and replace EVERY change_me/replace_* value.
# Generate a DIFFERENT value with `openssl rand -hex 32` for each password/token below.
# Hex passwords are safe to interpolate into these connection URLs without URL encoding.
APP_ENV=development
PUBLIC_URL=http://localhost:8000

# Compose bootstrap. postgres owns migrations; neuraldesk_app is the runtime role.
COMPOSE_PROJECT_NAME=neuraldesk
NEURALDESK_IMAGE=neuraldesk:local
POSTGRES_DB=neuraldesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
APP_DB_PASSWORD=change_me
REDIS_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://neuraldesk_app:${APP_DB_PASSWORD}@db:5432/${POSTGRES_DB}
MIGRATION_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
SECRET_KEY=change_me
METRICS_TOKEN=change_me

# Register an OIDC confidential web client and a JWT access-token audience.
# Redirect URI: http://localhost:8000/auth/callback
# The issuer must be reachable by BOTH your browser and the application containers.
OIDC_ISSUER=https://issuer.example.invalid/replace_with_issuer_path
OIDC_CLIENT_ID=replace_with_registered_client_id
OIDC_CLIENT_SECRET=replace_with_registered_client_secret
OIDC_AUDIENCE=replace_with_api_audience
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles

# Opt in only after approving transmission of ticket/runbook text to this provider.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CLASSIFICATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=40
CONFIDENCE_THRESHOLD=0.75
RUNBOOK_SIMILARITY_THRESHOLD=0.80

SESSION_LIFETIME_SECONDS=3600
JOB_LEASE_SECONDS=180
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=10
DATABASE_POOL_SIZE=5
LOG_LEVEL=INFO
# Use 1 only with the supplied gateway and no direct access to API containers.
TRUSTED_PROXY_HOPS=1

# Secret-file alternatives are described in docs/environment.md.
# Clear the corresponding direct variable before using its _FILE alternative.
# DATABASE_URL_FILE=/run/secrets/database_url
# MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url
# REDIS_URL_FILE=/run/secrets/redis_url
# SECRET_KEY_FILE=/run/secrets/secret_key
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# METRICS_TOKEN_FILE=/run/secrets/metrics_token
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# APP_DB_PASSWORD_FILE=/run/secrets/app_db_password
# REDIS_PASSWORD_FILE=/run/secrets/redis_password

# Optional host-side demo.py settings; these are NOT passed to the API/worker.
# Use a dedicated evaluation tenant and a genuine agent/admin OIDC access token.
# NEURALDESK_URL=http://localhost:8000
# NEURALDESK_TOKEN_FILE=./secrets/demo_token
# Alternatively set NEURALDESK_TOKEN, never both token sources.
