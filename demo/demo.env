# Public, synthetic fixtures for the loopback-only RunbookSignal demo.
# These values are intentionally committed and MUST NOT be reused outside this demo.
COMPOSE_PROJECT_NAME=runbooksignal-demo
NEURALDESK_IMAGE=runbooksignal-demo:local

APP_ENV=development
PUBLIC_URL=http://localhost:8000
DEMO_MODE=true

POSTGRES_DB=runbooksignal_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1111111111111111111111111111111111111111111111111111111111111111
APP_DB_PASSWORD=2222222222222222222222222222222222222222222222222222222222222222
DATABASE_URL=postgresql+psycopg://neuraldesk_app:${APP_DB_PASSWORD}@db:5432/${POSTGRES_DB}
MIGRATION_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

REDIS_PASSWORD=3333333333333333333333333333333333333333333333333333333333333333
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
SECRET_KEY=4444444444444444444444444444444444444444444444444444444444444444
METRICS_TOKEN=5555555555555555555555555555555555555555555555555555555555555555

OIDC_ISSUER=http://127.0.0.1:8081/realms/runbooksignal-demo
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/runbooksignal-demo/.well-known/openid-configuration
OIDC_CLIENT_ID=runbooksignal-demo
OIDC_CLIENT_SECRET=runbooksignal-demo-client-secret-not-for-reuse
OIDC_AUDIENCE=runbooksignal-api
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles

AI_ENABLED=true
OPENAI_API_KEY=runbooksignal-local-model-stub-key-not-a-secret
OPENAI_BASE_URL=http://model-stub:8080/v1
CLASSIFICATION_MODEL=runbooksignal-demo-deterministic
EMBEDDING_MODEL=runbooksignal-demo-embedding
AI_TIMEOUT_SECONDS=5
CONFIDENCE_THRESHOLD=0.75
RUNBOOK_SIMILARITY_THRESHOLD=0.80

SESSION_LIFETIME_SECONDS=3600
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=0.25
RATE_LIMIT_PER_MINUTE=600
AI_RATE_LIMIT_PER_MINUTE=120
DATABASE_POOL_SIZE=5
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=1

DEMO_STUB_CONTROL_TOKEN=runbooksignal-demo-control-token-not-for-reuse
