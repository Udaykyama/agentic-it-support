worker_processes auto;
pid /run/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;

    client_body_temp_path /run/nginx/client_body;
    proxy_temp_path /run/nginx/proxy;
    fastcgi_temp_path /run/nginx/fastcgi;
    uwsgi_temp_path /run/nginx/uwsgi;
    scgi_temp_path /run/nginx/scgi;

    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    upstream neuraldesk_api {
        zone neuraldesk_api 64k;
        server api:8000 resolve;
        keepalive 32;
    }

    server {
        listen 8080;
        server_name _;
        client_max_body_size 64k;
        client_body_timeout 15s;
        send_timeout 30s;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $PUBLIC_SCHEME;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;

        location = /gateway-health {
            default_type text/plain;
            return 200 "ready\n";
        }

        location = /auth/callback {
            # Upstream errors must not record OAuth authorization codes either.
            error_log /dev/null crit;
            proxy_pass http://neuraldesk_api;
        }

        location / {
            proxy_pass http://neuraldesk_api;
        }
    }
}
